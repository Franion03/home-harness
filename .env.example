# Local development.
#   cp .env.example .env && set -a && . ./.env && set +a
#   cd harness/app && uvicorn main:app --reload --port 8080
#
# This server holds NO model-vendor keys. Open WebUI owns model routing;
# nothing here ever talks to an LLM.

# ── Home Assistant ───────────────────────────────────────────────────────
# Token: HA -> click your user (bottom left) -> Security -> Long-lived access
# tokens -> Create token.
HA_URL=http://192.168.1.117:8123
HA_TOKEN=

# ── Google Calendar and Tasks ──────────────────────────────────────────────────────
# python3 scripts/google_oauth.py --client-id ... --client-secret ...
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Google Tasks shares the OAuth grant above -- no extra credential, but the
# consent must have carried the auth/tasks scope. "@default" is the user's
# default list.
GOOGLE_TASKLIST_ID=@default

# ── This server ──────────────────────────────────────────────────────────
# Shared secret Open WebUI sends as a Bearer token. openssl rand -hex 24
TOOLS_API_KEY=
TZ=Europe/Madrid
LOG_LEVEL=INFO

# ── Body metrics (read-only) ─────────────────────────────────────────────
# Home Assistant writes health data to InfluxDB; this service only reads it.
# In-cluster the URL is http://influxdb.health.svc.cluster.local:8086
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=casa
INFLUXDB_BUCKET=health
